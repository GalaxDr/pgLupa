# Configuração opcional. Sem .env, a ferramenta usa o ambiente de exemplo do docker compose
# (os valores abaixo são os padrões). Para monitorar outro servidor, copie este arquivo para .env
# e mantenha apenas as linhas que mudarem.

# Banco de dados da ferramenta
DATABASE_URL=postgres://ferramenta:ferramenta@127.0.0.1:5433/ferramenta

# Servidor monitorado
SERVIDOR_NOME=local
LOG_DIR=./docker/logs
# Conexão somente leitura (papel pg_read_all_stats) para os snapshots do pg_stat_statements;
# deixe vazia para desativá-los
MONITORADO_URL=postgres://monitor:monitor@127.0.0.1:5434/loja
# true: grava apenas o texto normalizado, sem os valores das consultas (dados pessoais)
ANONIMIZAR_VALORES=false

# Ajustes finos (raramente necessários)
# LOG_FORMAT=csvlog            # csvlog ou jsonlog; por padrão, pela extensão dos arquivos
# RETENCAO_DIAS=30             # 0 = nunca remove
# INTERVALO_LEITURA_MS=2000
# INTERVALO_SNAPSHOT_MS=60000
