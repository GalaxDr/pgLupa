# Configuração opcional: copie para .env e ajuste. Sem .env, a ferramenta usa o banco do
# docker compose e funciona pelo envio de arquivos de log (http://localhost:3000).

# Para o coletor acompanhar um servidor continuamente, informe o diretório dos logs dele
LOG_DIR=/var/lib/postgresql/18/main/log
# Nome do servidor no painel
SERVIDOR_NOME=local
# Conexão somente leitura (papel pg_read_all_stats) para os snapshots do pg_stat_statements (opcional)
# MONITORADO_URL=postgres://monitor:senha@127.0.0.1:5432/banco
# true: grava apenas o texto normalizado, sem os valores das consultas (dados pessoais)
ANONIMIZAR_VALORES=false

# Banco de dados da ferramenta (padrão: o do docker compose)
# DATABASE_URL=postgres://ferramenta:ferramenta@127.0.0.1:5433/ferramenta

# Ajustes finos (raramente necessários)
# LOG_FORMAT=csvlog            # csvlog ou jsonlog; por padrão, pela extensão dos arquivos
# RETENCAO_DIAS=30             # 0 = nunca remove
# INTERVALO_LEITURA_MS=2000
# INTERVALO_SNAPSHOT_MS=60000
