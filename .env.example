# Banco de dados da ferramenta (docker compose: serviço "ferramenta")
DATABASE_URL=postgres://ferramenta:ferramenta@127.0.0.1:5433/ferramenta

# Servidor monitorado, cadastrado automaticamente pelo coletor ao iniciar
SERVIDOR_NOME=local
LOG_DIR=./docker/logs
LOG_FORMAT=csvlog

# Conexão somente leitura com o servidor monitorado, para os snapshots do pg_stat_statements.
# Deixe vazio para desativar os snapshots.
MONITORADO_URL=postgres://monitor:monitor@127.0.0.1:5434/loja
# true: não armazena os valores das consultas, apenas o texto normalizado (dados pessoais)
ANONIMIZAR_VALORES=false

# Intervalos do coletor
INTERVALO_LEITURA_MS=2000
INTERVALO_SNAPSHOT_MS=60000

# Ocorrências e snapshots mais antigos que isso são removidos (0 = nunca)
RETENCAO_DIAS=30

# Usado apenas pelo gerador de carga de exemplo (npm run carga)
CARGA_URL=postgres://postgres:postgres@127.0.0.1:5434/loja
