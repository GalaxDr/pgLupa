# Modelo do .env.producao, criado no servidor pelo script deploy/instalar-no-servidor.sh

# Endereço do site. Sem domínio próprio, use o IP do servidor com o sslip.io
# (ex.: 150.230.10.20 -> 150-230-10-20.sslip.io); o HTTPS é emitido automaticamente.
DOMINIO=exemplo.sslip.io

# Senha do banco de dados (gerada automaticamente pelo script de instalação)
SENHA_BANCO=TROQUE_ESTA_SENHA

# Tamanho máximo do arquivo enviado, em MB
MAX_UPLOAD_MB=1024

# Tempo, em horas, que cada relatório fica disponível antes de ser apagado
RETENCAO_ANALISE_HORAS=72
